#: app/routes.py:43
msgid "Username or email already exists."
msgstr "El nom d'usuari o el correu electrònic ja existeix."

#: app/routes.py:51
msgid "Account created. Please log in."
msgstr "Compte creat. Si us plau, inicia sessió."

#: app/routes.py:65
msgid "Invalid username or password."
msgstr "Nom d'usuari o contrasenya invàlids."

#: app/routes.py:102
msgid "Invalid code. Try again."
msgstr "Codi invàlid. Torna-ho a intentar."

#: app/routes.py:122
